{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "HttpsRedirection": {
    "HttpsPort": 7080
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]

    },
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:medzo.database.windows.net,1433;Initial Catalog=medzo;Persist Security Info=False;User ID=medzo;Password={your_SQL_password};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;",
    "JdbcConnection": "jdbc:sqlserver://medzo.database.windows.net:1433;database=medzo;user=medzo@medzo;password={your_JDBC_password};encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=30;"
  },
  
  "Jwt": {
    "Secret": "{your_JWT_secret_key}",
    "Issuer": "MedzoAuthService",
    "Audience": "MedzoClient",
    "ExpirationInMinutes": "120",
    "RefreshTokenExpirationInDays": "7"
  }
}
  
